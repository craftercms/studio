<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.craftercms.studio.api.v2.dal.system.SystemPropertiesDAO">

    <select id="getProperties" resultType="org.craftercms.studio.api.v2.dal.system.SystemProperty">
        SELECT property_name AS name, property_value AS value
        FROM system_properties
        WHERE property_name IN
        <foreach item="propertyName" collection="propertyNames" open="(" separator="," close=")">
            #{propertyName}
        </foreach>
    </select>

    <update id="upsertProperties">
        INSERT INTO system_properties (property_name, property_value)
        VALUES
        <foreach item="property" collection="properties" separator=",">
            (#{property.name}, #{property.value})
        </foreach>
        ON DUPLICATE KEY UPDATE property_value = VALUES(property_value)
    </update>

    <delete id="deleteProperties">
        DELETE FROM system_properties
        WHERE property_name IN
        <foreach item="property" collection="properties" open="(" separator="," close=")">
            #{property.name}
        </foreach>
    </delete>
</mapper>
